# Public origin. Creem builds the post-checkout redirect from this, so when
# testing a real checkout through the ngrok tunnel set it to the tunnel URL
# (https://my-portfolio.ngrok.app) -- localhost is rejected and falls back to
# production, which would send a tester to the live site mid-test.
NEXT_PUBLIC_SITE_URL=https://example.com

# Payload / Supabase Postgres
DATABASE_URI=
PAYLOAD_SECRET=

# Supabase Storage (S3-compatible) for media
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Resend (contact notifications)
RESEND_API_KEY=
RESEND_FROM=Amware <hello@amware.dev>
CONTACT_NOTIFY_TO=

# Creem.io commerce (B2)
CREEM_API_URL=https://api.creem.io
CREEM_API_KEY=
# Signing secret from the Creem dashboard. Verification fails closed: with
# this empty every webhook is rejected 401, including valid ones. Register the
# endpoint as <origin>/webhooks/creem -- via the tunnel that is
# https://my-portfolio.ngrok.app/webhooks/creem
CREEM_WEBHOOK_SECRET=
# Capability access-token signing secret (independent of PAYLOAD_SECRET)
ACCESS_TOKEN_SECRET=

# GitHub token used to send the repository invitation a boilerplate buyer
# paid for, and to raise the rate limit on the pre-purchase username lookup.
# Unset is safe: invitations fall back to the manual path rather than failing
# the sale, which also means a broken token is silent -- run `pnpm sim` to
# check one. Fine-grained PAT owned by the ORG with Administration: read and
# write on the kit repositories; a classic PAT needs `repo`.
# Full setup, and why an OAuth App is not the answer: docs/github-token.md
GITHUB_TOKEN=
